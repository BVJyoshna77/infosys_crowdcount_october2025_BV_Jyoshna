#task 3 string operators

a = "Hello"
b = "World"

# 1. Concatenation 
concat = a + " " + b 

# 2. Repetition 
repeat = a * 3  

# 3. Indexing 
first_char = a[0]    

# 4. Slicing 
slice_substring = a[1:4] 

# 5. Membership (in)
is_in = "e" in a      

# 6. Membership (not in)
not_in = "x" not in a 

print("a =", a)
print("b =", b)
print("Concatenation: a + ' ' + b =", concat)
print("Repetition: a * 3 =", repeat)
print("Indexing: a[0] =", first_char)
print("Slicing: a[1:4] =", slice_substring)
print("'e' in a:", is_in)
print("'x' not in a:", not_in)
